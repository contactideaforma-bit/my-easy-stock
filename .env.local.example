# --- Supabase (même projet que My Easy Stock) ---
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_ANON
# Clé secrète (Settings > API > service_role) — JAMAIS côté navigateur
SUPABASE_SERVICE_ROLE_KEY=VOTRE_CLE_SERVICE_ROLE

# --- Adresse publique de l'appli (liens dans les mails) ---
NEXT_PUBLIC_APP_URL=https://my-assistanad.vercel.app

# --- Emails automatiques (resend.com, gratuit jusqu'à 3 000 mails/mois) ---
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM="Cabinet Nad <relances@votre-domaine.fr>"

# --- SMS automatiques (brevo.com > SMS, ~0,05 €/SMS) ---
BREVO_API_KEY=xkeysib-xxxxxxxx

# --- Sécurité de la tâche planifiée quotidienne (Vercel Cron) ---
CRON_SECRET=une-longue-phrase-secrete-au-hasard
